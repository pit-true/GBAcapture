# ESP32-P4-Pico 向け。docs/recorder-plan-esp32p4.md の構成。
# 1) ターゲット
CONFIG_IDF_TARGET="esp32p4"

# 2) チップリビジョン。実機の esptool 表示は "ESP32-P4 (revision v1.3)"
#    (2026-10-14 実機確認)。Waveshare 公式の rev1_3 プロファイルに合わせる。
#    rev >= 3.0 と < 3.0 は相互排他。既定(v3.1)でビルドすると v1.3 では起動しない。
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# 3) CPU / 自由動作(省電力しない。モバイルバッテリー給電だが性能優先)
#    rev < 3.0 の上限は 360MHz。400MHz は追加審査を通ったチップだけの実験的オプション
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_FREERTOS_HZ=1000
#    どのタスクが CPU を食っているかコンソール 'p' で出すため統計を有効にする
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# 3) PSRAM 32MB(HEX)。フレームバッファとエンコーダ入出力用
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n

# 4) フラッシュ(Waveshare P4-Pico は 16MB)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 5) シリアル書き込み(CH343P 経由。BOOT 保持で UART ブート)
#    この基板には DTR/RTS→EN/RST の自動リセット回路が無い(実機で確認済み)。
#    なので esptool にリセットをさせない。書き込み前に BOOT+RST でダウンロードモードへ入れ、
#    書き込み後は RST を 1 回押して起動させる。
#    既定の default_reset だと DTR/RTS を組み合わせて無駄に失敗する。
CONFIG_ESPTOOLPY_BEFORE_NORESET=y
#    ESPTOOLPY_AFTER_RESET は bool(既定 y = 書き込み後にハードリセット)。
#    RTS がないので実際にはリセットされない。p4boot.py が RUN コマンドで起動させる。
CONFIG_ESPTOOLPY_AFTER_RESET=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# 6) SD(SDMMC 4bit, FATFS)
CONFIG_FATFS_VOLUME_COUNT=1
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_FS_LOCK=0
# FatFs の FAT 表ウィンドウとファイル別キャッシュは内部 RAM に置く。
# PSRAM だと SDMMC の DMA が古いキャッシュ線を読み、FAT 表の更新だけが壊れて
# 一定サイズで errno=5 になった(2026-10-18 実測: 32MB テストが 16MB 地点で失敗)
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=n
# SD のセクタは 512B。4096 にすると FatFs のウィンドウが 4KB になり、
# FAT 表の 1 セクタ書き込みがカードに届かず FR_INT_ERR になる疑い(2026-10-18 実測)
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_IMMEDIATE_FSYNC=n
CONFIG_FATFS_PER_FILE_CACHE=y

# 7) USB ホスト(HS 側 = P1 ヘッダ)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
# nano の EP は全部 512B。BIAS_IN だと nptx=64 行(256B)で
# "EP MPS (512) exceeds supported limit (256)" になる。BALANCED なら
# nptx=256 行(1024B)、rx=fifo_size-384 行で IN も 512B を通る。
CONFIG_USB_HOST_HW_BUFFER_BIAS_BALANCED=y

# 8) ログ
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# 9) スタック/ヒープの安全策
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HEAP_POISONING_COMPREHENSIVE=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 10) タスクウォッチドッグ(エンコード直後の書き込みで数秒かかることがある)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 11) パーティション(アプリ 6MB。データは SD に書くのでフラッシュ側は最小)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# ESP32-P4 の bootloader は -Os でも 0x60c0 バイトあり、既定の 0x8000 に収まらない。
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# 12) 起動時のベンチは走らせない。SD があると muxer 込みのベンチになり、
#     完了まで約 2 分コンソールが塞がって実機テストの邪魔になる。
#     必要ならコンソールの b(エンコーダ単体)で都度測る。
CONFIG_GBAC_BENCH_FRAMES=0

# 13) MSC デバイス(espressif/esp_tinyusb 1.x)。コンソールの 'm' で
#     ホスト(nano 受信)⇄デバイス(PC から SD リーダ)を切り替える。
#     MSC の入出力バッファは P4 既定の 8192B をそのまま使う。
#     PC が抜いたときに TinyUSB が自動で FAT を載せ直す先は /sd(同じカード)。
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_MSC_MOUNT_PATH="/sd"
