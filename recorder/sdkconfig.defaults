# ESP32-P4-Pico 向け。docs/recorder-plan-esp32p4.md の構成。
# 1) ターゲット
CONFIG_IDF_TARGET="esp32p4"

# 2) CPU / 自由動作(省電力しない。モバイルバッテリー給電だが性能優先)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_FREERTOS_HZ=1000

# 3) PSRAM 32MB(HEX)。フレームバッファとエンコーダ入出力用
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n

# 4) フラッシュ(Waveshare P4-Pico は 16MB)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 5) シリアル書き込み(CH343P 経由。BOOT 保持で UART ブート)
CONFIG_ESPTOOLPY_BAUD_921600=y
CONFIG_ESPTOOLPY_BEFORE_RESET=y
CONFIG_ESPTOOLPY_AFTER_RESET="hard"

# 6) SD(SDMMC 4bit, FATFS)
CONFIG_FATFS_VOLUME_COUNT=1
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_FS_LOCK=0
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
CONFIG_FATFS_IMMEDIATE_FSYNC=n
CONFIG_FATFS_PER_FILE_CACHE=y

# 7) USB ホスト(HS 側 = P1 ヘッダ)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# 8) ログ
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# 9) スタック/ヒープの安全策
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HEAP_POISONING_COMPREHENSIVE=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 10) タスクウォッチドッグ(エンコード直後の書き込みで数秒かかることがある)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 11) パーティション(アプリ 6MB。データは SD に書くのでフラッシュ側は最小)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# ESP32-P4 の bootloader は -Os でも 0x60c0 バイトあり、既定の 0x8000 に収まらない。
CONFIG_PARTITION_TABLE_OFFSET=0x10000
