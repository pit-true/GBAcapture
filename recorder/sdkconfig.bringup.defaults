# 最小起動確認(BRINGUP)用。docs/esp32p4-flashing.md の「起動確認の階段」。
# PSRAM と周辺を切って、ログと LED 点滅だけを見る設定。
# ビルド: idf.py -B build-bringup -D SDKCONFIG_DEFAULTS=sdkconfig.bringup.defaults
# 書き込み: idf.py -B build-bringup -p COM6 flash

CONFIG_IDF_TARGET="esp32p4"

# チップリビジョン v1.3 向け(Waveshare rev1_3 プロファイル)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# CPU は本番と同じ 360MHz。ここが違うとクロック系の問題切り分けができない
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_FREERTOS_HZ=1000

# PSRAM は使わない(PSRAM 初期化失敗で起動しない、を切り分けるため)
CONFIG_SPIRAM=n

# フラッシュは本番で実際に書き込んでいる dio / 16MB / 80MHz に合わせる
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESPTOOLPY_BEFORE_NORESET=y
CONFIG_ESPTOOLPY_AFTER_RESET=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# コンソールは UART0(GPIO37=TX, GPIO38=RX)を CH343 が読む。115200
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# BRINGUP 本体
CONFIG_GBAC_BRINGUP=y
CONFIG_GBAC_BENCH_FRAMES=0
CONFIG_GBAC_SD_PWR_GPIO=-1
