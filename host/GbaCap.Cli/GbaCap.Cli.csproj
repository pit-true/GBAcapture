<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GbaCap\GbaCap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
  </ItemGroup>

  <ItemGroup>
    <!-- libusb-1.0 ネイティブDLL (x64)。取得元は docs/setup.md 参照 -->
    <None Update="native\libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="libusb-1.0.dll" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
